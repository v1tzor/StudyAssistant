# Docker
POSTGRES_DB=studyassistant
POSTGRES_USER=studyassistant_admin
POSTGRES_PASSWORD='change_admin_password'

# Ktor
DATABASE_URL='jdbc:postgresql://127.0.0.1:5432/studyassistant'
DATABASE_USER=studyassistant_app
DATABASE_PASSWORD='change_app_password'
DATABASE_APP_PASSWORD='change_app_password'

# Flyway
FLYWAY_URL='jdbc:postgresql://127.0.0.1:5432/studyassistant'
FLYWAY_USER=studyassistant_migrator
FLYWAY_PASSWORD='change_migrator_password'
DATABASE_MIGRATOR_PASSWORD='change_migrator_password'

# Security
INSTALLATION_HMAC_SECRET='openssl rand -hex 32'
SHARE_HMAC_SECRET='openssl rand -hex 32'
PAYLOAD_ENCRYPTION_KEY='openssl rand -hex 32'

# Shared AI
DEEPSEEK_API_KEY='replace_with_server_side_key'
OPENROUTER_API_KEY='replace_with_server_side_key'
OPENROUTER_SOCKS_HOST=127.0.0.1
OPENROUTER_SOCKS_PORT=10808
