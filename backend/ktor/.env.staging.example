COMPOSE_PROJECT_NAME=studyassistant-backend-staging
BACKEND_IMAGE=studyassistant-backend:staging
EXPECTED_HOST=staging-api.studyassistant-app.ru
STAGING_BACKEND_PORT=18081
AI_GLOBAL_DAILY_EXECUTION_LIMIT=100
DEEPSEEK_MAX_CONCURRENT_REQUESTS=2
DATABASE_MAXIMUM_POOL_SIZE=3

POSTGRES_DB=studyassistant_staging
POSTGRES_USER=studyassistant_admin

POSTGRES_ADMIN_PASSWORD_FILE=/etc/studyassistant-staging/secrets/postgres_admin_password
DATABASE_APP_PASSWORD_FILE=/etc/studyassistant-staging/secrets/database_app_password
DATABASE_MIGRATOR_PASSWORD_FILE=/etc/studyassistant-staging/secrets/database_migrator_password
INSTALLATION_HMAC_SECRET_FILE=/etc/studyassistant-staging/secrets/installation_hmac_secret
SHARE_HMAC_SECRET_FILE=/etc/studyassistant-staging/secrets/share_hmac_secret
PAYLOAD_ENCRYPTION_KEY_FILE=/etc/studyassistant-staging/secrets/payload_encryption_key
DEEPSEEK_API_KEY_FILE=/etc/studyassistant-staging/secrets/deepseek_api_key
OPENROUTER_API_KEY_FILE=/etc/studyassistant-staging/secrets/openrouter_api_key
OPENROUTER_SOCKS_HOST=xray
OPENROUTER_SOCKS_PORT=10808
OPENROUTER_XRAY_CONFIG_FILE=/etc/studyassistant-staging/xray/config.json
