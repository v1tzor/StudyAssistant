CREATE TABLE aiSettingsEntity_new (
  id INTEGER PRIMARY KEY NOT NULL,
  quota_remaining INTEGER NOT NULL,
  quota_limit INTEGER NOT NULL,
  rewarded_resets_remaining INTEGER NOT NULL,
  quota_reset_at INTEGER DEFAULT NULL
);

INSERT INTO aiSettingsEntity_new (
  id,
  quota_remaining,
  quota_limit,
  rewarded_resets_remaining,
  quota_reset_at
)
SELECT
  id,
  MIN(quota_remaining, 10),
  10,
  2,
  quota_reset_at
FROM aiSettingsEntity;

DROP TABLE aiSettingsEntity;

ALTER TABLE aiSettingsEntity_new RENAME TO aiSettingsEntity;
