ALTER TABLE employeeEntity RENAME TO legacyEmployeeEntity;

CREATE TABLE employeeEntity (
  uid TEXT PRIMARY KEY NOT NULL,
  organization_id TEXT NOT NULL,
  first_name TEXT NOT NULL,
  second_name TEXT,
  patronymic TEXT,
  post TEXT NOT NULL,
  avatar TEXT,
  birthday TEXT,
  workTimeStart INTEGER,
  workTimeEnd INTEGER,
  emails TEXT NOT NULL,
  phones TEXT NOT NULL,
  locations TEXT NOT NULL,
  webs TEXT NOT NULL,
  updated_at INTEGER NOT NULL
);

INSERT INTO employeeEntity
SELECT uid, organization_id, first_name, second_name, patronymic, post, avatar, birthday,
       workTimeStart, workTimeEnd, emails, phones, locations, webs, updated_at
FROM legacyEmployeeEntity
WHERE is_cache_data = 0;

DROP TABLE legacyEmployeeEntity;

