CREATE TABLE subjectEntity (
    uid TEXT PRIMARY KEY NOT NULL,
    organization_id TEXT NOT NULL,
    event_type TEXT NOT NULL,
    name TEXT NOT NULL,
    teacher_id TEXT,
    office TEXT NOT NULL,
    color INTEGER NOT NULL,
    location TEXT,
    updated_at INTEGER NOT NULL
);

addOrUpdateSubject:
INSERT OR REPLACE INTO subjectEntity (uid, organization_id, event_type, name, teacher_id, office, color, location, updated_at)
VALUES ?;

fetchSubjectById:
SELECT *
FROM subjectEntity
WHERE uid = ?;

fetchAllSubjects:
SELECT *
FROM subjectEntity;


fetchSubjectsByOrganization:
SELECT *
FROM subjectEntity
WHERE organization_id = ?;

fetchSubjectsByOrganizations:
SELECT *
FROM subjectEntity
WHERE organization_id IN ?;

fetchSubjectsByEmployee:
SELECT *
FROM subjectEntity
WHERE teacher_id = ?;

fetchSubjectsByNames:
SELECT *
FROM subjectEntity
WHERE name IN ?;

deleteSubjects:
DELETE FROM subjectEntity
WHERE uid IN ?;

deleteAllSubjects:
DELETE FROM subjectEntity;
