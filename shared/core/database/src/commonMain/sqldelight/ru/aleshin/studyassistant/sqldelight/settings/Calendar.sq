import kotlin.String;
import kotlin.collections.List;

CREATE TABLE calendarSettingsEntity (
  id INTEGER PRIMARY KEY NOT NULL,
  number_of_week TEXT NOT NULL,
  week_schedule_view_type TEXT NOT NULL,
  holidays TEXT AS List<String>,
  updated_at INTEGER NOT NULL
);

INSERT INTO calendarSettingsEntity (id, number_of_week, week_schedule_view_type, holidays, updated_at)
VALUES (1, 'ONE', 'COMMON', NULL, 0);

fetchSettings:
SELECT *
FROM calendarSettingsEntity;


addOrUpdateSettings:
INSERT OR REPLACE INTO calendarSettingsEntity (id, number_of_week, week_schedule_view_type, holidays, updated_at)
VALUES ?;
