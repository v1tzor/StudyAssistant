import kotlin.String;
import kotlin.collections.List;

CREATE TABLE customScheduleEntity (
  uid TEXT PRIMARY KEY NOT NULL,
  date INTEGER NOT NULL,
  classes TEXT AS List<String> NOT NULL,
  updated_at INTEGER NOT NULL
);

addOrUpdateSchedule:
INSERT OR REPLACE INTO customScheduleEntity (uid, date, classes, updated_at)
VALUES ?;

fetchScheduleById:
SELECT *
FROM customScheduleEntity
WHERE uid = ?;

fetchSchedulesByDate:
SELECT *
FROM customScheduleEntity
WHERE date = ?
ORDER BY date DESC
LIMIT 1;

fetchSchedulesByTimeRange:
SELECT *
FROM customScheduleEntity
WHERE date >= ? AND date <= ?
ORDER BY date DESC;

deleteSchedulesById:
DELETE FROM customScheduleEntity
WHERE uid IN ?;

deleteSchedulesByTimeRange:
DELETE FROM customScheduleEntity
WHERE date >= ? AND date <= ?;
