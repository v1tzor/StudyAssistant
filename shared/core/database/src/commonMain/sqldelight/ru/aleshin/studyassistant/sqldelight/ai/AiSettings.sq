CREATE TABLE aiSettingsEntity (
  id INTEGER PRIMARY KEY NOT NULL,
  quota_remaining INTEGER NOT NULL,
  quota_limit INTEGER NOT NULL,
  rewarded_resets_remaining INTEGER NOT NULL,
  quota_reset_at INTEGER DEFAULT NULL
);

INSERT INTO aiSettingsEntity (
  id,
  quota_remaining,
  quota_limit,
  rewarded_resets_remaining,
  quota_reset_at
)
VALUES (1, 12, 12, 3, NULL);

fetchSettings:
SELECT *
FROM aiSettingsEntity
WHERE id = 1;

updateSettings:
INSERT OR REPLACE INTO aiSettingsEntity (
  id,
  quota_remaining,
  quota_limit,
  rewarded_resets_remaining,
  quota_reset_at
)
VALUES ?;
